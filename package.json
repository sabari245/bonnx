{
  "name": "onnxviz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "SINGLE=1 vite build --outDir dist-single",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "desktop": "SINGLE=1 vite build --outDir dist-single && electron .",
    "desktop:dist": "SINGLE=1 vite build --outDir dist-single && electron-builder --linux"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide": "^1.51.0",
    "tailwind-merge": "^3.7.0"
  },
  "main": "electron/main.cjs",
  "description": "Fast, offline ONNX model visualizer",
  "author": "sabari245",
  "homepage": "https://github.com/sabari245/onnxviz",
  "repository": "github:sabari245/onnxviz",
  "license": "MIT",
  "build": {
    "appId": "io.github.sabari245.onnxviz",
    "productName": "ONNX Viz",
    "executableName": "onnxviz",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "dist-single/**",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Development",
      "icon": "icon.png",
      "mimeTypes": [
        "application/x-onnx"
      ],
      "synopsis": "ONNX model visualizer",
      "fileAssociations": [
        {
          "ext": "onnx",
          "name": "ONNX model",
          "mimeType": "application/x-onnx"
        }
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3",
        "libxss1",
        "libasound2"
      ]
    },
    "artifactName": "onnxviz-${version}-${arch}.${ext}"
  }
}
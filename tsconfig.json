{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true, "noUncheckedIndexedAccess": false, "noEmit": true, "skipLibCheck": true, "isolatedModules": true,
    "types": ["vite/client"], "paths": {"@/*": ["./src/*"], "#spawn": ["./src/workers/spawn.ts"]}
  },
  "include": ["src", "tests"]
}
